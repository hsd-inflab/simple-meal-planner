<?xml version="1.0"?>
<ruleset name="Studenten Regeln"
    xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>Angepasste PMD Regeln gegen typische Anfängerfehler</description>

    <!-- Findet leere Catch-Blöcke, if(true), NullPointer-Gefahren -->
    <rule ref="category/java/errorprone.xml">
        <!-- Manchmal wollen Studis leere Catch-Blöcke machen, hier verbieten wir es strikt -->
    </rule>
    
    <!-- Findet unbenutzte private Methoden, Variablen und Parameter -->
    <rule ref="category/java/bestpractices.xml">
        <!-- Wir erlauben System.out.println für Anfänger-Projekte -->
        <exclude name="SystemPrintln"/>
        <exclude name="GuardLogStatement"/> 
    </rule>

    <!-- Code Smells: Zu komplexe Methoden, tiefe Verschachtelungen -->
    <rule ref="category/java/design.xml">
        <exclude name="LoosePackageCoupling"/>
        <exclude name="LawOfDemeter"/> <!-- Für Anfänger oft zu abstrakt -->
    </rule>
</ruleset>