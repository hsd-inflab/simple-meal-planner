<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
          "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
          "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="fileExtensions" value="java"/>

    <!-- Max 120 Zeichen pro Zeile -->
    <module name="LineLength">
        <property name="max" value="150"/>
        <property name="ignorePattern" value="^package.*|^import.*|a href|href|http://|https://|ftp://"/>
    </module>

    <module name="TreeWalker">
        <!-- Naming Conventions -->
        <module name="TypeName"/> <!-- Klassen: UpperCamelCase -->
        <module name="MethodName"/> <!-- Methoden: lowerCamelCase -->
        <module name="LocalVariableName"/> <!-- Lokale Variablen: lowerCamelCase -->
        <module name="ParameterName"/> <!-- Parameter: lowerCamelCase -->
        <module name="ConstantName"/> <!-- Konstanten: UPPER_SNAKE_CASE -->
        
        <!-- Imports -->
        <module name="AvoidStarImport"/> <!-- Keine import java.util.* -->
        <module name="UnusedImports"/> <!-- Keine ungenutzten Imports -->
        
        <!-- Klammern & Blöcke -->
        <module name="NeedBraces"/> <!-- if/for/while brauchen immer {} -->
        <module name="LeftCurly"/> <!-- { am Ende der Zeile -->
        <module name="RightCurly"/> <!-- } in einer neuen Zeile -->
        <module name="EmptyBlock"/> <!-- Keine leeren {} Blöcke -->

        <!-- Best Practices -->
        <module name="StringLiteralEquality"/> <!-- String Vergleich mit equals, nicht == -->
        <module name="OneStatementPerLine"/>
    </module>
</module>