# Environment variable template for simple-meal-planner.
# Copy this file to .env and fill in the values. The .env file is gitignored
# and must never be committed.

# --- PostgreSQL (local / docker profile) ---
LOCAL_DB_NAME=
LOCAL_DB_USER=
LOCAL_DB_PASSWORD=

# --- PostgreSQL (production container, compose.prod.yaml) ---
# Must differ from the LOCAL_DB_* values above: separate container, separate volume, separate credentials.
PROD_DB_NAME=
PROD_DB_USER=
PROD_DB_PASSWORD=

# --- flyway migration ---
flyway.url=
flyway.user=
flyway.password=
flyway.locations=

# --- Recipe API (RapidAPI: gustar-io-deutsche-rezepte) ---
# Obtain your own key from the RapidAPI dashboard.
RECIPE_API_KEY=
# SHA-256 hash used by the recipe API integration.
RECIPE_API_PWHASH=

# --- JWT / Auth ---
# Signing secret for JWT tokens. Must be at least 32 bytes (256 bit) for HMAC-SHA256.
JWT_SECRET=
